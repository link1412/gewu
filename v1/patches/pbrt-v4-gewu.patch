+// gewu: FamilyMapSpectrumTexture Method Definitions
+namespace {
+
+// The arrays of an .npz written by numpy's np.savez (a zip of .npy files, stored, not
+// compressed; numpy writes zip64 sizes in the local headers). Float64 or float32,
+// little-endian, C order.
+std::map<std::string, std::pair<std::vector<int>, std::vector<double>>> ReadNpz(
+    const std::string &filename, const FileLoc *loc) {
+    std::string b = ReadFileContents(filename);
+    auto u16 = [&](size_t o) {
+        return uint32_t(uint8_t(b[o])) | (uint32_t(uint8_t(b[o + 1])) << 8);
+    };
+    auto u32 = [&](size_t o) { return u16(o) | (u16(o + 2) << 16); };
+    auto u64 = [&](size_t o) { return uint64_t(u32(o)) | (uint64_t(u32(o + 4)) << 32); };
+    std::map<std::string, std::pair<std::vector<int>, std::vector<double>>> out;
+    size_t o = 0;
+    while (o + 30 <= b.size() && u32(o) == 0x04034b50) {
+        uint32_t flags = u16(o + 6), method = u16(o + 8);
+        uint64_t csize = u32(o + 18), usize = u32(o + 22);
+        uint32_t nl = u16(o + 26), el = u16(o + 28);
+        std::string name = b.substr(o + 30, nl);
+        size_t e = o + 30 + nl, eEnd = e + el;
+        while (e + 4 <= eEnd) {
+            uint32_t id = u16(e), sz = u16(e + 2);
+            if (id == 1) {
+                size_t f = e + 4;
+                if (usize == 0xffffffff) {
+                    usize = u64(f);
+                    f += 8;
+                }
+                if (csize == 0xffffffff) {
+                    csize = u64(f);
+                    f += 8;
+                }
+            }
+            e += 4 + sz;
+        }
+        if (method != 0 || (flags & 8) || csize != usize)
+            ErrorExit(loc, "%s: %s is compressed or streamed; write the family with np.savez",
+                      filename, name);
+        size_t d = o + 30 + nl + el;
+        if (d + csize > b.size())
+            ErrorExit(loc, "%s: truncated", filename);
+        std::string npy = b.substr(d, csize);
+        if (npy.size() < 10 || npy.compare(0, 6, "\x93NUMPY") != 0)
+            ErrorExit(loc, "%s: %s is not an .npy array", filename, name);
+        int major = uint8_t(npy[6]);
+        size_t hl = major == 1 ? size_t(uint8_t(npy[8]) | (uint8_t(npy[9]) << 8))
+                               : size_t(uint8_t(npy[8]) | (uint8_t(npy[9]) << 8) |
+                                        (uint8_t(npy[10]) << 16) | (uint8_t(npy[11]) << 24));
+        size_t h0 = major == 1 ? 10 : 12;
+        std::string header = npy.substr(h0, hl);
+        bool f8 = header.find("'<f8'") != std::string::npos;
+        bool f4 = header.find("'<f4'") != std::string::npos;
+        if ((!f8 && !f4) || header.find("'fortran_order': False") == std::string::npos)
+            ErrorExit(loc, "%s: %s must be little-endian float64/float32 in C order (%s)",
+                      filename, name, header);
+        size_t sp = header.find("'shape': (");
+        if (sp == std::string::npos)
+            ErrorExit(loc, "%s: %s has no shape", filename, name);
+        std::vector<int> shape;
+        size_t q = sp + 10;
+        while (q < header.size() && header[q] != ')') {
+            if (isdigit(header[q])) {
+                size_t r = q;
+                while (r < header.size() && isdigit(header[r]))
+                    ++r;
+                shape.push_back(std::stoi(header.substr(q, r - q)));
+                q = r;
+            } else
+                ++q;
+        }
+        size_t count = 1;
+        for (int v : shape)
+            count *= v;
+        size_t data = h0 + hl, width = f8 ? 8 : 4;
+        if (data + count * width > npy.size())
+            ErrorExit(loc, "%s: %s is truncated", filename, name);
+        std::vector<double> v(count);
+        for (size_t j = 0; j < count; ++j) {
+            if (f8) {
+                double x;
+                memcpy(&x, npy.data() + data + 8 * j, 8);
+                v[j] = x;
+            } else {
+                float x;
+                memcpy(&x, npy.data() + data + 4 * j, 4);
+                v[j] = x;
+            }
+        }
+        if (name.size() > 4 && name.compare(name.size() - 4, 4, ".npy") == 0)
+            name = name.substr(0, name.size() - 4);
+        out[name] = {shape, v};
+        o = d + csize;
+    }
+    return out;
+}
