+// gewu: FamilyMapSpectrumTexture Definition
+// A spectrum that runs through a one-parameter family R(lambda; c), c read from a float image
+// map (docs/textures.md "familymap"): the members are piecewise linear in lambda (zero outside
+// their samples, as PiecewiseLinearSpectrum), the family is linear in c between members and
+// clamped to the first and last member. The family is an .npz file (numpy's np.savez, not
+// compressed) with lambda_nm (K,), c (N,) strictly ascending, R (N, K).
+class FamilyMapSpectrumTexture {
+  public:
+    FamilyMapSpectrumTexture(FloatImageTexture *map, pstd::vector<Float> lambda,
+                             pstd::vector<Float> c, pstd::vector<Float> R)
+        : map(map), lambda(std::move(lambda)), c(std::move(c)), R(std::move(R)) {}
+
+    PBRT_CPU_GPU
+    SampledSpectrum Evaluate(TextureEvalContext ctx, SampledWavelengths lambdas) const {
+#ifdef PBRT_IS_GPU_CODE
+        assert(!"Should not be called in GPU code");
+        return SampledSpectrum(0.f);
+#else
+        Float cv = Clamp(map->Evaluate(ctx), c.front(), c.back());
+        int n = c.size(), k = lambda.size();
+        int i = FindInterval(n, [&](int j) { return c[j] <= cv; });
+        Float t = (cv - c[i]) / (c[i + 1] - c[i]);
+        SampledSpectrum s;
+        for (int w = 0; w < NSpectrumSamples; ++w) {
+            Float l = lambdas[w];
+            if (l < lambda.front() || l > lambda.back()) {
+                s[w] = 0;
+                continue;
+            }
+            int o = FindInterval(k, [&](int j) { return lambda[j] <= l; });
+            Float u = (l - lambda[o]) / (lambda[o + 1] - lambda[o]);
+            Float r0 = Lerp(u, R[i * k + o], R[i * k + o + 1]);
+            Float r1 = Lerp(u, R[(i + 1) * k + o], R[(i + 1) * k + o + 1]);
+            s[w] = Lerp(t, r0, r1);
+        }
+        return s;
+#endif
+    }
+
+    static FamilyMapSpectrumTexture *Create(const Transform &renderFromTexture,
+                                            const TextureParameterDictionary &parameters,
+                                            SpectrumType spectrumType, const FileLoc *loc,
+                                            Allocator alloc);
+
+    std::string ToString() const;
+
+  private:
+    FloatImageTexture *map;
+    pstd::vector<Float> lambda, c, R;
+};
