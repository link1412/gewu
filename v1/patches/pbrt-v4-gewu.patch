+FamilyMapSpectrumTexture *FamilyMapSpectrumTexture::Create(
+    const Transform &renderFromTexture, const TextureParameterDictionary &parameters,
+    SpectrumType spectrumType, const FileLoc *loc, Allocator alloc) {
+    std::string family = ResolveFilename(parameters.GetOneString("family", ""));
+    std::string mapName = ResolveFilename(parameters.GetOneString("map", ""));
+    if (family.empty() || mapName.empty())
+        ErrorExit(loc, "familymap needs \"string family\" and \"string map\"");
+    if (!parameters.GetFloatArray("scale").empty() ||
+        !parameters.GetBoolArray("invert").empty())
+        ErrorExit(loc, "familymap reads c as the map's value; \"scale\" and \"invert\" "
+                       "are not handled");
+    auto arrays = ReadNpz(family, loc);
+    for (const char *k : {"lambda_nm", "c", "R"})
+        if (arrays.find(k) == arrays.end())
+            ErrorExit(loc, "%s: no array \"%s\"", family, k);
+    const auto &L = arrays["lambda_nm"], &C = arrays["c"], &Rr = arrays["R"];
+    size_t K = L.second.size(), N = C.second.size();
+    if (Rr.first.size() != 2 || Rr.first[0] != (int)N || Rr.first[1] != (int)K || N < 2 ||
+        K < 2)
+        ErrorExit(loc, "%s: need c (N>=2), lambda_nm (K>=2) and R of shape (N, K)", family);
+    for (size_t i = 1; i < N; ++i)
+        if (!(C.second[i] > C.second[i - 1]))
+            ErrorExit(loc, "%s: c must ascend strictly", family);
+    for (size_t i = 1; i < K; ++i)
+        if (!(L.second[i] > L.second[i - 1]))
+            ErrorExit(loc, "%s: lambda_nm must ascend strictly", family);
+    for (double r : Rr.second)
+        if (r < 0 || r > 1)
+            ErrorExit(loc, "%s: R must lie in [0, 1]", family);
+
+    // The map: a float image texture as "imagemap" reads it, with scale 1 and no inversion
+    TextureMapping2D map =
+        TextureMapping2D::Create(parameters, renderFromTexture, loc, alloc);
+    MIPMapFilterOptions filterOptions;
+    filterOptions.maxAnisotropy = parameters.GetOneFloat("maxanisotropy", 8.f);
+    std::string filter = parameters.GetOneString("filter", "bilinear");
+    pstd::optional<FilterFunction> ff = ParseFilter(filter);
+    if (!ff)
+        ErrorExit(loc, "%s: filter function unknown", filter);
+    filterOptions.filter = *ff;
+    std::string wrapString = parameters.GetOneString("wrap", "repeat");
+    pstd::optional<WrapMode> wrapMode = ParseWrapMode(wrapString.c_str());
+    if (!wrapMode)
+        ErrorExit(loc, "%s: wrap mode unknown", wrapString);
+    const char *defaultEncoding = HasExtension(mapName, "png") ? "sRGB" : "linear";
+    ColorEncoding encoding =
+        ColorEncoding::Get(parameters.GetOneString("encoding", defaultEncoding), alloc);
+    FloatImageTexture *cmap = alloc.new_object<FloatImageTexture>(
+        map, mapName, filterOptions, *wrapMode, 1.f, false, encoding, alloc);
+
+    pstd::vector<Float> lambda(alloc), c(alloc), R(alloc);
+    for (double v : L.second)
+        lambda.push_back(v);
+    for (double v : C.second)
+        c.push_back(v);
+    for (double v : Rr.second)
+        R.push_back(v);
+    return alloc.new_object<FamilyMapSpectrumTexture>(cmap, std::move(lambda), std::move(c),
+                                                      std::move(R));
+}
