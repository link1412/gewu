+// gewu: refractive next-event estimation.
+//
+// Light reaches a point inside a glaze only across the glaze surface, where SampleLd()'s
+// shadow ray stops. SampleLdRefracted() connects the vertex x to a sampled point z on an
+// area light through one refraction y on a "refractivenee" dielectric, whose
+// transmission is smooth. SolveRefraction() finds y: Snell's law on the tangent plane
+// at a first crossing (along the guide, the normal of the last surface the path met,
+// else along the straight line to z), then the crossing is moved on the real surface
+// until it stops moving. Thin dielectrics between x and y pass the light straight on
+// and only attenuate it. The connection's density over directions at x is
+//   p(z) / J,   J = dw_x / dA_z,
+// J by differences of re-traced directions: the surface's curvature focuses the light
+// (13% for 1 mm under a 5 mm radius) and so do bumps.
+// A path that BSDF sampling carries the same way (non-specular x, thin dielectrics, the
+// refraction, the light; rneeState 2 in Li()) drops its emission only if the solver,
+// started at x, finds that same crossing: the connection has counted it. Crossings the
+// solver misses (several solutions near edges, far ones) stay with BSDF sampling, so
+// nothing is lost or counted twice. The two are not MIS-weighted: that would need the
+// Jacobian on every such path too, and measured no less noise on a glaze slab.
+STAT_PERCENT("Integrator/Refracted light connections not converged", rneeUnconverged,
+             rneeConnections);
+STAT_PERCENT("Integrator/Refracted light Jacobians from the tangent plane", rneePlanarJ,
+             rneeJacobians);
+
+namespace {
+
+// Where the connection from x to z crosses a plane: x at depth a on one side, z at
+// height b on the other, their feet on the plane D apart, etaRatio = eta on x's side /
+// eta on z's side. Returns the distance from x's foot. Snell's law,
+//   etaRatio t / sqrt(t^2 + a^2) = (D - t) / sqrt((D - t)^2 + b^2),
+// has its left minus right side increasing in t, so Newton steps are kept in a bracket.
+double PlanarCrossing(double a, double b, double D, double etaRatio) {
+    if (D <= 0)
+        return 0;
+    auto g = [&](double t) {
+        return etaRatio * t / std::sqrt(t * t + a * a) -
+               (D - t) / std::sqrt((D - t) * (D - t) + b * b);
+    };
+    auto dg = [&](double t) {
+        return etaRatio * a * a / std::pow(t * t + a * a, 1.5) +
+               b * b / std::pow((D - t) * (D - t) + b * b, 1.5);
+    };
+    double lo = 0, hi = D;
+    double sinZ = D / std::sqrt(D * D + b * b);
+    double sinX = std::min(0.999999, sinZ / etaRatio);
+    double t = Clamp(a * sinX / std::sqrt(1 - sinX * sinX), lo, hi);
+    for (int i = 0; i < 60; ++i) {
+        double gt = g(t);
+        if (gt > 0)
+            hi = t;
+        else
+            lo = t;
+        double d = dg(t);
+        double tn = d > 0 ? t - gt / d : 0.5 * (lo + hi);
+        if (!(tn > lo && tn < hi))
+            tn = 0.5 * (lo + hi);
+        bool done = std::abs(tn - t) <= 1e-12 * (a + D);
+        t = tn;
+        if (done)
+            break;
+    }
+    return t;
+}
+
+// dw_x / dA_z for a refraction at a plane: a, b distances of x and z from it, the
+// cosines to its normal on x's side (X) and z's side (Z), cosL the cosine at the light.
+// With r = a tan X + b tan Z between the feet, dw_x = sin X dX dphi and
+// dA_z = r dr dphi cos Z / cosL. Exact for a plane; a fallback when differencing fails.
+double PlanarRefractionJacobian(double a, double b, double cosX, double cosZ,
+                                double etaRatio, double cosL) {
+    if (cosX <= 0 || cosZ <= 0)
+        return 0;
+    double sinX = std::sqrt(std::max(0.0, 1 - cosX * cosX));
+    double sinZ = std::sqrt(std::max(0.0, 1 - cosZ * cosZ));
+    if (sinX < 1e-7)
+        return cosL / ((a + b * etaRatio) * (a + b * etaRatio));
+    double r = a * sinX / cosX + b * sinZ / cosZ;
+    double drdX = a / (cosX * cosX) + b / (cosZ * cosZ) * etaRatio * cosX / cosZ;
+    return sinX / (r * drdX) * cosL / cosZ;
+}
+
+// The material that decides what happens at a surface, mixes resolved as GetBSDF() does.
+Material ResolvedMaterial(const SurfaceInteraction &si) {
+    Material m = si.material;
+    while (m.Is<MixMaterial>())
+        m = m.Cast<MixMaterial>()->ChooseMaterial(UniversalTextureEvaluator(), si);
+    return m;
+}
+
+bool IsRefractiveNEE(Material m) {
+    const DielectricMaterial *d = m.CastOrNullptr<DielectricMaterial>();
+    return d && d->RefractiveNEE();
+}
+
+}  // namespace
+
+// The first "refractivenee" dielectric along the ray from x in direction d, no farther
+// than reach, passing null surfaces and thin dielectrics; false at anything else.
+bool VolPathIntegrator::RefractiveCrossing(const Interaction &x, Vector3f d, Float reach,
+                                           SampledWavelengths lambda, Sampler sampler,
+                                           ScratchBuffer &scratchBuffer,
+                                           SurfaceInteraction *y, BSDF *yBSDF) const {
+    Point3f target = x.p() + Normalize(d) * reach;
+    Ray r = x.SpawnRayTo(target);
+    while (true) {
+        pstd::optional<ShapeIntersection> si = Intersect(r, 1 - ShadowEpsilon);
+        if (!si)
+            return false;
+        Material m = ResolvedMaterial(si->intr);
+        if (!m || m.Is<ThinDielectricMaterial>()) {
+            r = si->intr.SpawnRayTo(target);
+            continue;
+        }
+        if (!IsRefractiveNEE(m))
+            return false;
+        *y = si->intr;
+        *yBSDF = y->GetBSDF(RayDifferential(r), lambda, camera, scratchBuffer, sampler);
+        return (bool)*yBSDF;
+    }
+}
+
+pstd::optional<VolPathIntegrator::RefractedConnection> VolPathIntegrator::SolveRefraction(
+    const Interaction &x, Vector3f guide, Point3f pz, const SampledWavelengths &lambda,
+    Sampler sampler, ScratchBuffer &scratchBuffer) const {
+    Point3f px = x.p();
+    Float reach = Distance(px, pz);
+    for (int start = LengthSquared(guide) > 0 ? 0 : 1; start < 2; ++start) {
+        // Start from the interface along the guide, else on the straight line to z
+        Vector3f d = start == 0 ? guide : pz - px;
+        SurfaceInteraction y;
+        BSDF yBSDF;
+        if (!RefractiveCrossing(x, d, reach, lambda, sampler, scratchBuffer, &y, &yBSDF))
+            continue;
+        Vector3f n;
+        Float eta, hx, hz;
+        auto planeAtY = [&]() {
+            n = Normalize(yBSDF.LocalToRender(Vector3f(0, 0, 1)));
+            eta = yBSDF.GetBxDF<DielectricBxDF>()->Eta();
+            hx = Dot(px - y.p(), n);
+            hz = Dot(pz - y.p(), n);
+        };
+        planeAtY();
+        // The direction x -> y is built from the solved angle, not from the two nearby
+        // points: x is often a hair under the surface. Each step undershoots by about
+        // (depth / curvature radius)(1 - cos_z / (eta cos_x)): one step on a vase wall,
+        // up to 0.4 per step at a 1.5 mm rim.
+        bool lost = false;
+        for (int iter = 0; iter < 16 && hx * hz < 0; ++iter) {
+            // eta is the index behind the normal over the one in front of it
+            Float etaRatio = hx < 0 ? eta : 1 / eta;
+            Vector3f along = (pz - hz * n) - (px - hx * n);
+            Float D = Length(along);
+            double t = PlanarCrossing(std::abs(hx), std::abs(hz), D, etaRatio);
+            Vector3f d2 = (hx < 0 ? n : -n) * std::abs(hx);
+            if (D > 0)
+                d2 += along * Float(t / D);
+            SurfaceInteraction y2;
+            BSDF y2BSDF;
+            if (!RefractiveCrossing(x, d2, reach, lambda, sampler, scratchBuffer, &y2,
+                                    &y2BSDF)) {
+                lost = true;
+                break;
+            }
+            Float moved = Distance(y2.p(), y.p());
+            y = y2;
+            yBSDF = y2BSDF;
+            d = d2;
+            planeAtY();
+            if (moved <= 1e-5f * std::abs(hx) + 1e-6f * MaxComponentValue(Abs(y.p())))
+                break;
+        }
+        if (lost || hx * hz >= 0)
+            continue;
+        // Snell's law at y with y's own normal
+        Vector3f wx = -Normalize(d), wz = Normalize(pz - y.p()), wt;
+        Float etap;
+        if (!Refract(wx, Normal3f(n), eta, &etap, &wt) || Length(Cross(wt, wz)) > 1e-3f ||
+            Dot(wt, wz) <= 0) {
+            ++rneeUnconverged;
+            continue;
+        }
+        return RefractedConnection{y, -wx, Normal3f(n), eta, etap};
+    }
+    return {};
+}
+
+// dw_x / dA_z of the connection c from x to the light's tangent plane at pz: directions
+// h off c.w are traced through the interface (normals as shaded, so curvature and bumps
+// count) and differenced against c.w's own trace. Each offset is tried on both sides, so
+// a connection near the critical angle steps away from total reflection. The tangent
+// plane at y stands in only if both sides fail (a crossing at an edge of the interface).
+Float VolPathIntegrator::RefractedJacobian(const Interaction &x,
+                                           const RefractedConnection &c, Point3f pz,
+                                           Normal3f nz, const SampledWavelengths &lambda,
+                                           Sampler sampler,
+                                           ScratchBuffer &scratchBuffer) const {
+    ++rneeJacobians;
+    Float reach = Distance(x.p(), pz);
+    auto toLightPlane = [&](Vector3f dir, Point3f *pl) {
+        SurfaceInteraction yh;
+        BSDF yhBSDF;
+        if (!RefractiveCrossing(x, dir, reach, lambda, sampler, scratchBuffer, &yh,
+                                &yhBSDF))
+            return false;
+        Vector3f nh = Normalize(yhBSDF.LocalToRender(Vector3f(0, 0, 1))), wt;
+        Float etap, cosL;
+        if (!Refract(-Normalize(dir), Normal3f(nh), yhBSDF.GetBxDF<DielectricBxDF>()->Eta(),
+                     &etap, &wt) ||
+            (cosL = Dot(wt, Vector3f(nz))) == 0)
+            return false;
+        *pl = yh.p() + wt * (Dot(pz - yh.p(), Vector3f(nz)) / cosL);
+        return true;
+    };
+    Vector3f e[2];
+    CoordinateSystem(c.w, &e[0], &e[1]);
+    constexpr Float h = 3e-4f;
+    Point3f z0, zh;
+    Vector3f dz[2];
+    bool ok = toLightPlane(c.w, &z0);
+    for (int k = 0; k < 2 && ok; ++k) {
+        if (toLightPlane(c.w + h * e[k], &zh))
+            dz[k] = zh - z0;
+        else if (toLightPlane(c.w - h * e[k], &zh))
+            dz[k] = z0 - zh;
+        else
+            ok = false;
+    }
+    Float J = ok ? h * h / Length(Cross(dz[0], dz[1])) : 0;
+    if (J > 0 && !IsInf(J))
+        return J;
+    ++rneePlanarJ;
+    Vector3f n(c.n), wz = Normalize(pz - c.y.p());
+    Float hx = Dot(x.p() - c.y.p(), n);
+    return PlanarRefractionJacobian(std::abs(hx), std::abs(Dot(pz - c.y.p(), n)),
+                                    AbsDot(c.w, n), AbsDot(wz, n),
+                                    hx < 0 ? c.eta : 1 / c.eta, AbsDot(wz, nz));
+}
+
+// Whether SampleLdRefracted() at x (light sampling context ctx, guide) counts the light
+// reached at `light` through the crossing py: it can sample that point and its solver
+// finds that crossing.
+bool VolPathIntegrator::RefractionCovered(const Interaction &x,
+                                          const LightSampleContext &ctx, Vector3f guide,
+                                          Point3f py, const SurfaceInteraction &light,
+                                          const SampledWavelengths &lambda,
+                                          Sampler sampler,
+                                          ScratchBuffer &scratchBuffer) const {
+    Light l(light.areaLight);
+    Vector3f toZ = Normalize(light.p() - ctx.p());
+    if (lightSampler.PMF(ctx, l) == 0 || l.PDF_Li(ctx, toZ, false) == 0 ||
+        !l.L(light.p(), light.n, light.uv, -toZ, lambda))
+        return false;
+    pstd::optional<RefractedConnection> c =
+        SolveRefraction(x, guide, light.p(), lambda, sampler, scratchBuffer);
+    return c && Distance(c->y.p(), py) <=
+                    1e-2f * Distance(x.p(), py) + 1e-5f * MaxComponentValue(Abs(py));
+}
+
+SampledSpectrum VolPathIntegrator::SampleLdRefracted(const Interaction &intr,
+                                                     const BSDF *bsdf, Vector3f guide,
+                                                     SampledWavelengths &lambda,
+                                                     Sampler sampler,
+                                                     ScratchBuffer &scratchBuffer,
+                                                     SampledSpectrum beta,
+                                                     SampledSpectrum r_p,
+                                                     int depth) const {
+    // Sample a point z on an area light; its density over the light's area
+    LightSampleContext ctx =
+        bsdf ? LightSampleContext(intr.AsSurface()) : LightSampleContext(intr);
+    Float u = sampler.Get1D();
+    pstd::optional<SampledLight> sampledLight = lightSampler.Sample(ctx, u);
+    Point2f uLight = sampler.Get2D();
+    if (!sampledLight || sampledLight->light.Type() != LightType::Area)
+        return SampledSpectrum(0.f);
+    Light light = sampledLight->light;
+    pstd::optional<LightLiSample> ls = light.SampleLi(ctx, uLight, lambda, false);
+    if (!ls || ls->pdf == 0)
+        return SampledSpectrum(0.f);
+    Point3f pz = ls->pLight.p();
+    Normal3f nz = ls->pLight.n;
+    Vector3f toZ = pz - ctx.p();
+    Float dist = Length(toZ);
+    Float pA = sampledLight->p * ls->pdf * AbsDot(nz, toZ / dist) / Sqr(dist);
+    if (pA == 0)
+        return SampledSpectrum(0.f);
+
+    ++rneeConnections;
+    pstd::optional<RefractedConnection> c =
+        SolveRefraction(intr, guide, pz, lambda, sampler, scratchBuffer);
+    if (!c)
+        return SampledSpectrum(0.f);
+
+    // Scattering at x toward y
+    Vector3f wi = c->w;
+    SampledSpectrum f_hat;
+    if (bsdf)
+        f_hat = bsdf->f(intr.wo, wi) * AbsDot(wi, intr.AsSurface().shading.n);
+    else
+        f_hat = SampledSpectrum(intr.AsMedium().phase.p(intr.wo, wi));
+    if (!f_hat)
+        return SampledSpectrum(0.f);
+
+    // Light leaving z toward y, through the interface
+    Vector3f wz = Normalize(pz - c->y.p());
+    SampledSpectrum Le = light.L(pz, nz, ls->pLight.uv, -wz, lambda);
+    if (!Le)
+        return SampledSpectrum(0.f);
+    Float T_F = 1 - FrDielectric(Dot(-wi, c->n), c->eta);
+    SampledSpectrum L_in = Le * T_F / Sqr(c->etap);
+
+    // Transmittance x -> y (thin dielectrics included) and y -> z, ratio tracking as in
+    // SampleLd()
+    SampledSpectrum T_ray(1.f), r_l(1.f), r_u(1.f);
+    RNG rng(Hash(intr.p()), Hash(pz));
+    auto track = [&](const Ray &ray, Float tMax) {
+        if (!ray.medium)
+            return;
+        Float u = rng.Uniform<Float>();
+        SampledSpectrum T_maj = SampleT_maj(
+            ray, tMax, u, rng, lambda,
+            [&](Point3f p, MediumProperties mp, SampledSpectrum sigma_maj,
+                SampledSpectrum T_maj) {
+                SampledSpectrum sigma_n = ClampZero(sigma_maj - mp.sigma_a - mp.sigma_s);
+                Float pdf = T_maj[0] * sigma_maj[0];
+                T_ray *= T_maj * sigma_n / pdf;
+                r_l *= T_maj * sigma_maj / pdf;
+                r_u *= T_maj * sigma_n / pdf;
+                SampledSpectrum Tr = T_ray / (r_l + r_u).Average();
+                if (Tr.MaxComponentValue() < 0.05f) {
+                    Float q = 0.75f;
+                    if (rng.Uniform<Float>() < q)
+                        T_ray = SampledSpectrum(0.);
+                    else
+                        T_ray /= 1 - q;
+                }
+                return (bool)T_ray;
+            });
+        T_ray *= T_maj / T_maj[0];
+        r_l *= T_maj / T_maj[0];
+        r_u *= T_maj / T_maj[0];
+    };
+    int nThin = 0;
+    // A zero direction: x lies within y's rounding error, nothing between them (as in
+    // SampleLd(); a ray with no direction intersects at t = NaN)
+    Ray ray = intr.SpawnRayTo(c->y);
+    while (ray.d != Vector3f(0, 0, 0)) {
+        pstd::optional<ShapeIntersection> si = Intersect(ray, 1 - ShadowEpsilon);
+        track(ray, si ? si->tHit : 1 - ShadowEpsilon);
+        if (!T_ray)
+            return SampledSpectrum(0.f);
+        if (!si)
+            break;
+        Material m = ResolvedMaterial(si->intr);
+        if (m) {
+            if (!m.Is<ThinDielectricMaterial>())
+                return SampledSpectrum(0.f);
+            ++nThin;
+            SampledWavelengths lambdaThin = lambda;
+            BSDF thin = si->intr.GetBSDF(RayDifferential(ray), lambdaThin, camera,
+                                         scratchBuffer, sampler);
+            if (lambdaThin.SecondaryTerminated())
+                ErrorExit("Refracted light connections pass thin dielectrics only "
+                          "with a constant \"eta\".");
+            // (SpawnRayTo's direction is not unit length: normalise it for the cosine)
+            T_ray *= thin.GetBxDF<ThinDielectricBxDF>()->Transmittance(
+                thin.RenderToLocal(Normalize(-ray.d)));
+            if (!T_ray)
+                return SampledSpectrum(0.f);
+        }
+        ray = si->intr.SpawnRayTo(c->y);
+    }
+    // BSDF sampling would stop at y if the depth ran out there
+    if (depth + nThin >= maxDepth)
+        return SampledSpectrum(0.f);
+    ray = c->y.SpawnRayTo(ls->pLight);
+    while (ray.d != Vector3f(0, 0, 0)) {
+        pstd::optional<ShapeIntersection> si = Intersect(ray, 1 - ShadowEpsilon);
+        if (si && ResolvedMaterial(si->intr))
+            return SampledSpectrum(0.f);
+        track(ray, si ? si->tHit : 1 - ShadowEpsilon);
+        if (!T_ray)
+            return SampledSpectrum(0.f);
+        if (!si)
+            break;
+        ray = si->intr.SpawnRayTo(ls->pLight);
+    }
+
+    // Like a delta light: BSDF sampling does not count these paths
+    Float J = RefractedJacobian(intr, *c, pz, nz, lambda, sampler, scratchBuffer);
+    if (!(J > 0))
+        return SampledSpectrum(0.f);
+    r_l *= r_p * (pA / J);
+    return beta * f_hat * T_ray * L_in / r_l.Average();
+}
