+          thickness(thickness),
+          n1(n1),
+          k1(k1),
+          n2(n2),
+          k2(k2),
+          rho(rho) {}
+
+    PBRT_CPU_GPU
+    BxDFFlags Flags() const {
+        BxDFFlags f = mfDistrib.EffectivelySmooth() ? BxDFFlags::SpecularReflection
